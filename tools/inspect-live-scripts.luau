local t={players={},sources={},gui={}}
for _,p in ipairs(game.Players:GetPlayers())do local e={name=p.Name,path=p:GetFullName(),children={}}for _,c in ipairs(p:GetDescendants())do if c:IsA("LuaSourceContainer")then table.insert(e.children,c:GetFullName())end end table.insert(t.players,e)end
for _,o in ipairs(game:GetDescendants())do if o:IsA("LuaSourceContainer")and(o.Name=="Keyboard"or o.Name=="BaseCamera"or o.Name=="ClassicCamera"or o.Name=="MouseLockController"or o.Name=="ZoomController"or o.Name=="CameraInput"or o.Name=="ControlModule"or o.Name=="PlayerModule"or o.Name=="MouseLockIcon"or o.Name=="nameColors")then local ok,src=pcall(function()return o.Source end)if ok then t.sources[o.Name]=src end end end
local cg=game.CoreGui
for _,o in ipairs(cg:GetDescendants())do if o:IsA("GuiObject")and(o:GetFullName():find("TopBarApp")or o:GetFullName():find("ExperienceChat.appLayout"))then local e={name=o.Name,path=o:GetFullName(),class=o.ClassName,pos={o.AbsolutePosition.X,o.AbsolutePosition.Y},size={o.AbsoluteSize.X,o.AbsoluteSize.Y},visible=o.Visible,bg={o.BackgroundColor3.R,o.BackgroundColor3.G,o.BackgroundColor3.B},transparency=o.BackgroundTransparency}if o:IsA("ImageLabel")or o:IsA("ImageButton")then e.image=o.Image e.offset={o.ImageRectOffset.X,o.ImageRectOffset.Y}e.rect={o.ImageRectSize.X,o.ImageRectSize.Y}end if o:IsA("TextLabel")or o:IsA("TextBox")or o:IsA("TextButton")then e.text=o.Text e.textSize=o.TextSize end table.insert(t.gui,e)end end
return game.HttpService:JSONEncode(t)
